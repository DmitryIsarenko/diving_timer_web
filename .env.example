# === Basic settings ===
SITE_BASE_URL=your-domain.org


# === Postgres ===
POSTGRES_VERSION=18
DB_PORT=5432
DB_NAME=db_name_example
DB_USER=db_user_example
DB_PASSWORD=unguessable-password
DB_HOST=postgres


# === Redis ===
REDIS_VERSION=8.10.2
REDIS_HOST=redis
REDIS_PORT=6379

REDIS_USER=redis_user
REDIS_USER_PASSWORD=unguessable-password
REDIS_PASSWORD=unguessable-password


# === Django ===
DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your.vps.server.ip,your-domain.org
SECRET_KEY=some-secret-key


# === Email / Gmail SMTP ===
EMAIL_HOST_USER=your-smtp-mail@gmail.com
EMAIL_HOST_PASSWORD=your-smtp-app-password
DEFAULT_FROM_EMAIL="Diving Timer <your-smtp-mail@gmail.com>"
EMAIL_VERIFICATION_MAX_AGE=86400